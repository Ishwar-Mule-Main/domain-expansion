datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum LeadStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  PROPOSAL_SENT
  CONVERTED
  LOST
  SPAM
}

model Lead {
  id           String     @id @default(uuid())
  name         String
  email        String
  phone        String?
  company      String?
  service      String
  budget       String?
  message      String     @db.Text
  status       LeadStatus @default(NEW)
  ipAddress    String?
  userAgent    String?
  referrer     String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum WaitlistRole {
  AGENCY
  CLIENT
}

model TechGuildWaitlist {
  id        String       @id @default(uuid())
  email     String       @unique
  role      WaitlistRole @default(CLIENT)
  company   String?
  phone     String?
  position  Int          @default(autoincrement())
  createdAt DateTime     @default(now())
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model AdminUser {
  id        String         @id @default(uuid())
  email     String         @unique
  password  String
  role      AdminRole      @default(ADMIN)
  lastLogin DateTime?
  sessions  AdminSession[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model AdminSession {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model PortfolioItem {
  id             String   @id @default(uuid())
  title          String
  clientName     String
  slug           String   @unique
  categories     String[]
  description    String   @db.Text
  image          String
  thumbnail      String
  metricHeadline String
  published      Boolean  @default(true)
  featured       Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum ProspectStatus {
  PENDING
  GENERATING
  READY
  SENDING
  SENT
  REPLIED
  FAILED
  UNSUBSCRIBED
}

model Prospect {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  company       String?
  industry      String?
  website       String?
  status        ProspectStatus @default(PENDING)
  customSubject String?        @db.Text
  customBody    String?        @db.Text
  sentAt        DateTime?
  repliedAt     DateTime?
  logs          EmailLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model EmailLog {
  id            String   @id @default(uuid())
  prospectId    String
  prospect      Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectEmail String
  action        String
  details       String?  @db.Text
  createdAt     DateTime @default(now())
}

model EmailSettings {
  id                 String   @id @default(uuid())
  gmailUser          String   @default("ishwar@domainexpansion.in")
  gmailAppPassword   String   @default("")
  smtpHost           String   @default("smtpout.secureserver.net")
  smtpPort           Int      @default(465)
  imapHost           String   @default("imap.secureserver.net")
  imapPort           Int      @default(993)
  geminiApiKey       String   @default("")
  openRouterApiKey   String   @default("")
  openRouterModel    String   @default("google/gemini-2.0-flash")
  preferredProvider  String   @default("GOOGLE") // "GOOGLE" | "OPENROUTER"
  fallbackEnabled    Boolean  @default(true)
  pitchPrompt        String   @default("You are an expert sales outreach copywriter writing on behalf of Domain Expansion, a premium B2B digital agency. Your goal is to write a highly personalized, unique cold email that reads like it was written by a real human, not AI. Avoid generic templates, standard greetings, or robotic transition phrases (such as 'I hope this email finds you well', 'As a startup ourselves', or empty flattery). Every single email must be dynamically structured and unique to prevent them from looking identical. Make sure to vary the subject lines, greetings, layout, and phrasing across generations.\n\nKey Brand Pillars & Actual Results of Domain Expansion to use:\n- We build high-performance, visually stunning websites and digital interfaces (custom styling, vector preloader smoothness, high-speed Next.js platforms).\n- We drive growth through data-driven engineering and design.\n- Highlight 2-3 clean, high-impact bullet points demonstrating our actual, quantified results we got so far:\n  * 10M+ Digital Touchpoints created across high-performance interfaces.\n  * 2,700+ High-Converting Leads generated for our B2B & B2C clients.\n  * 200+ Keywords ranked on Google Page 1, driving consistent organic pipeline.\n  * 21+ Successful Projects delivered across Marketing, Development, Design, and AI for 17+ industries.\n  * Proven outcomes: e.g. 320% organic traffic growth in 90 days, 41% lower Cost Per Lead (CPL) on paid advertising, and 40% Customer Acquisition Cost (CAC) reduction using custom AI/n8n automations.\n\nGuidelines for the email draft:\n1. Subject line: Craft a unique, high-intent subject line dynamically customized for the prospect's company name (do not use the same subject line for everyone).\n2. Structure: Keep it short (under 150 words). Include clean, punchy bullet points to highlight our results/case studies.\n3. Personalization: Construct a highly personalized opening hook specific to the prospect's company and industry. If no industry is provided, frame it broadly around digital customer acquisition.\n4. Tone: Confident, professional, direct, and conversational.\n5. Call to Action (CTA): Ask for a quick, low-friction, 10-minute chat or virtual coffee.") @db.Text
  replyPrompt        String   @default("You are an AI assistant at Domain Expansion. The prospect replied to our pitch email. Draft a friendly, professional response handling their questions, showing enthusiasm, and trying to book a meeting.") @db.Text
  dailyLimit         Int      @default(150)
  intervalSeconds    Int      @default(120)
  isActive           Boolean  @default(false)
  blogAutopilot      Boolean  @default(true)
  blogResearchModel  String   @default("mistralai/mistral-nemo:free")
  blogWriterModel    String   @default("qwen/qwen-2.5-72b-instruct:free")
  blogImageModel     String   @default("playgroundai/playground-v2.5")
  blogReviewerModel  String   @default("qwen/qwen3-coder:free")
  updatedAt          DateTime @updatedAt
}

model MasterBrainLog {
  id            String   @id @default(uuid())
  prospectId    String?
  prospectEmail String?
  provider      String   // "GOOGLE" | "OPENROUTER"
  model         String
  actionType    String   // "PITCH" | "REPLY"
  prompt        String   @db.Text
  response      String?  @db.Text
  status        String   // "SUCCESS" | "FAILED"
  errorMessage  String?  @db.Text
  createdAt     DateTime @default(now())
}

model BlogPost {
  id             String   @id @default(uuid())
  slug           String   @unique
  title          String
  excerpt        String   @db.Text
  category       String   // "marketing" | "development" | "design" | "ai" | "news"
  categoryLabel  String
  date           String   // e.g. "June 18, 2026"
  readTime       String
  author         String   @default("Ishwar Mule")
  authorRole     String   @default("Founder & CEO")
  authorImage    String   @default("/Team Members/Ishwar Mule.png")
  coverGradient  String   @default("from-[#FF6200]/30 to-[#6D28D9]/20")
  featuredImage  String?  @db.Text
  bodyHTML       String   @db.Text
  popular        Boolean  @default(false)
  schemaMarkup   String?  @db.Text  // Custom SEO/AEO/GEO/AIO JSON-LD schema
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SitemapUrl {
  id              String   @id @default(uuid())
  url             String   @unique
  lastModified    DateTime @default(now())
  changeFrequency String   @default("weekly")
  priority        Float    @default(0.6)
  createdAt       DateTime @default(now())
}

model BlogAgentLog {
  id            String   @id @default(uuid())
  piller        String   // "marketing" | "development" | "design" | "ai"
  status        String   // "SUCCESS" | "FAILED"
  topicSelected String?  @db.Text
  errorMessage  String?  @db.Text
  createdAt     DateTime @default(now())
}


