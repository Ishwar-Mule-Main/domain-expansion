datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum LeadStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  PROPOSAL_SENT
  CONVERTED
  LOST
  SPAM
}

model Lead {
  id           String     @id @default(uuid())
  name         String
  email        String
  phone        String?
  company      String?
  service      String
  budget       String?
  message      String     @db.Text
  status       LeadStatus @default(NEW)
  ipAddress    String?
  userAgent    String?
  referrer     String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum WaitlistRole {
  AGENCY
  CLIENT
}

model TechGuildWaitlist {
  id        String       @id @default(uuid())
  email     String       @unique
  role      WaitlistRole @default(CLIENT)
  company   String?
  phone     String?
  position  Int          @default(autoincrement())
  createdAt DateTime     @default(now())
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model AdminUser {
  id        String         @id @default(uuid())
  email     String         @unique
  password  String
  role      AdminRole      @default(ADMIN)
  lastLogin DateTime?
  sessions  AdminSession[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model AdminSession {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model PortfolioItem {
  id             String   @id @default(uuid())
  title          String
  clientName     String
  slug           String   @unique
  categories     String[]
  description    String   @db.Text
  image          String
  thumbnail      String
  metricHeadline String
  published      Boolean  @default(true)
  featured       Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum ProspectStatus {
  PENDING
  GENERATING
  READY
  SENDING
  SENT
  REPLIED
  FAILED
  UNSUBSCRIBED
}

model Prospect {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  company       String?
  industry      String?
  website       String?
  status        ProspectStatus @default(PENDING)
  customSubject String?        @db.Text
  customBody    String?        @db.Text
  sentAt        DateTime?
  repliedAt     DateTime?
  logs          EmailLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model EmailLog {
  id            String   @id @default(uuid())
  prospectId    String
  prospect      Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectEmail String
  action        String
  details       String?  @db.Text
  createdAt     DateTime @default(now())
}

model EmailSettings {
  id                 String   @id @default(uuid())
  gmailUser          String   @default("connect.domainexpansion@gmail.com")
  gmailAppPassword   String   @default("")
  geminiApiKey       String   @default("")
  pitchPrompt        String   @default("Write a cold email to the prospect pitching our digital services at Domain Expansion. Highlight how we are a startup B2B digital agency and can help them grow by sharing our case studies. Keep it short, professional, and personalized to their company and industry. Ask if we can jump on a quick call.") @db.Text
  replyPrompt        String   @default("You are an AI assistant at Domain Expansion. The prospect replied to our pitch email. Draft a friendly, professional response handling their questions, showing enthusiasm, and trying to book a meeting.") @db.Text
  dailyLimit         Int      @default(150)
  intervalSeconds    Int      @default(120)
  isActive           Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}
